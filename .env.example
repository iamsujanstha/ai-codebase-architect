# Database
# Required by Compose and the backend connection pool.
POSTGRES_URL=
POSTGRES_SSL=true
POSTGRES_POOL_MAX=20
STORE_SEED_ON_BOOT=false

# AI service
AI_PROVIDER=ollama
AI_MODEL=deepseek-coder:6.7b
AI_TIMEOUT_SECONDS=120
AI_CONCURRENCY=1
AI_MAX_OUTPUT_TOKENS=2048
AI_SERVICE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_API_KEY=
AI_BASE_URL=
RETRIEVAL_BACKEND=none
EMBEDDING_MODEL=
MEMORY_COLLECTION=knowledge
RETRIEVAL_CORPUS=reference

# Public URLs and authentication
FRONTEND_PUBLIC_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:8000
# Generate a unique random value with at least 32 characters for each environment.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Atlas Commerce Lab" <noreply@atlascommerce.dev>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_SHIPPING_FEE_USD=0

# eSewa test configuration. Use managed secrets for production credentials.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/
