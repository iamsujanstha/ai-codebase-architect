# =========================================================
# ROOT ENVIRONMENT TEMPLATE
# =========================================================
# This file demonstrates the most important environment variables for running
# the platform locally or pointing the NestJS backend at MongoDB Atlas.
#
# How to use:
# 1. Copy this file to `.env`
# 2. Fill in the Atlas connection string if you want cloud MongoDB
# 3. Run `docker compose up --build`
#
# If `MONGODB_URI` is left unset, docker-compose.yml falls back to the local
# Mongo container automatically.

# -------------------------
# Email (Nodemailer)
# -------------------------
# For local testing use Mailpit (runs in Docker on port 1025 / UI on 8025)
# or any SMTP service (Gmail, SendGrid, Resend, etc.)
#
# Mailpit example (zero-config local SMTP):
#   MAIL_HOST=mailpit
#   MAIL_PORT=1025
#   MAIL_USER=
#   MAIL_PASS=
#
# Gmail example (use an App Password, not your real password):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USER=you@gmail.com
#   MAIL_PASS=your-app-password
#   MAIL_FROM="Atlas Commerce Lab" <you@gmail.com>
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Atlas Commerce Lab" <noreply@atlascommerce.dev>

# -------------------------
# MongoDB / Mongoose
# -------------------------
# Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=atlas-commerce-lab
MONGODB_URI=
MONGODB_DB_NAME=ai_commerce_platform
MONGODB_AUTO_INDEX=true
STORE_SEED_ON_BOOT=true

# -------------------------
# Public URLs
# -------------------------
# These must point to publicly reachable URLs in real payment environments.
# Stripe webhooks cannot reach localhost from the public internet unless you
# use Stripe CLI forwarding or a tunnel such as ngrok.
# eSewa browser redirects can still work locally when the browser can reach
# the backend URL directly, but production environments should still use real
# public URLs.
FRONTEND_PUBLIC_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:3000

# -------------------------
# Local Ollama
# -------------------------
OLLAMA_MODEL=deepseek-coder:6.7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -------------------------
# Stripe
# -------------------------
# Real Stripe keys belong in your local `.env` or deployment secret manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_SHIPPING_FEE_USD=0

# -------------------------
# eSewa
# -------------------------
# Official UAT values from eSewa docs are used as safe defaults for testing.
# Switch to the production URLs and your real merchant credentials when going live.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q(
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_TAX_AMOUNT_NPR=0
ESEWA_SERVICE_CHARGE_NPR=0
ESEWA_DELIVERY_CHARGE_NPR=0
