generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts_demo {
  id         Int       @id @default(autoincrement())
  user_id    Int
  balance    Decimal   @db.Decimal(10, 2)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_messages {
  id           Int          @id @default(autoincrement())
  thread_id    Int
  role         String       @db.VarChar(20)
  content      String
  timestamp    DateTime     @default(now()) @db.Timestamptz(6)
  chat_threads chat_threads @relation(fields: [thread_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([thread_id], map: "idx_chat_messages_thread_id")
  @@index([thread_id, timestamp], map: "idx_chat_messages_thread_timestamp")
  @@index([timestamp], map: "idx_chat_messages_timestamp")
}

model chat_threads {
  id               Int             @id @default(autoincrement())
  user_id          Int
  title            String?         @db.VarChar(500)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  client_thread_id String?         @db.VarChar(255)
  model            String?         @db.VarChar(100)
  chat_messages    chat_messages[]
  users            users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_chat_threads_created")
  @@index([user_id], map: "idx_chat_threads_user_id")
  @@index([user_id, client_thread_id], map: "idx_chat_threads_client_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model idempotency_keys {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(255)
  response   Json?
  status     String   @default("processing") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  @@index([expires_at], map: "idx_idempotency_expires")
  @@index([key], map: "idx_idempotency_key")
}

model idempotency_keys_demo {
  id         Int       @id @default(autoincrement())
  key        String    @unique @db.VarChar(255)
  status     String?   @default("processing") @db.VarChar(20)
  response   Json?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model inventory_locks_demo {
  id        Int     @id @default(autoincrement())
  item_name String? @db.VarChar(100)
  stock     Int?
  reserved  Int?    @default(0)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  name       String   @db.VarChar(500)
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int
  subtotal   Decimal  @default(dbgenerated("(price * (quantity)::numeric)")) @db.Decimal(10, 2)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order_id")
  @@index([product_id], map: "idx_order_items_product_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                Int           @id @default(autoincrement())
  user_id           Int
  order_number      String        @unique @db.VarChar(50)
  total_amount      Decimal       @db.Decimal(10, 2)
  status            String        @default("pending") @db.VarChar(20)
  payment_method    String?       @db.VarChar(20)
  payment_intent_id String?       @db.VarChar(255)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @default(now()) @db.Timestamptz(6)
  order_items       order_items[]
  users             users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_orders_created_at")
  @@index([order_number], map: "idx_orders_order_number")
  @@index([status], map: "idx_orders_status")
  @@index([user_id, created_at(sort: Desc)], map: "idx_orders_user_created")
  @@index([user_id], map: "idx_orders_user_id")
  @@index([user_id, status, created_at(sort: Desc)], map: "idx_orders_user_status_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payment_audit_logs {
  id              Int      @id @default(autoincrement())
  order_number    String   @db.VarChar(50)
  event_type      String   @db.VarChar(100)
  timestamp       DateTime @default(now()) @db.Timestamptz(6)
  provider        String   @db.VarChar(20)
  user_id         Int?
  actor           String   @db.VarChar(20)
  previous_status String?  @db.VarChar(20)
  new_status      String?  @db.VarChar(20)
  details         Json?
  ip_address      String?  @db.Inet
  correlation_id  String?  @db.Uuid
  success         Boolean
  message         String?
  users           users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([correlation_id], map: "idx_audit_correlation_id")
  @@index([details], map: "idx_audit_details_gin", type: Gin)
  @@index([order_number], map: "idx_audit_order_number")
  @@index([timestamp(sort: Desc)], map: "idx_audit_timestamp")
}

model payments {
  id         Int       @id @default(autoincrement())
  user_id    Int
  amount     Decimal   @db.Decimal(10, 2)
  currency   String?   @default("USD") @db.VarChar(3)
  status     String?   @default("pending") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(500)
  description String?
  price       Decimal       @db.Decimal(10, 2)
  category    String        @db.VarChar(100)
  stock       Int           @default(0)
  image_url   String?       @db.VarChar(500)
  featured    Boolean       @default(false)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  status      String?       @default("published") @db.VarChar(20)
  sku         String?       @db.VarChar(50)
  deleted_at  DateTime?     @db.Timestamptz(6)
  order_items order_items[]

  @@index([category], map: "idx_products_category")
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_products_name_trgm", type: Gin)
}

model rate_limits {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(255)
  count        Int      @default(1)
  window_start DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)

  @@index([expires_at], map: "idx_rate_limits_expires")
  @@index([key], map: "idx_rate_limits_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique @db.VarChar(255)
  password            String?              @db.VarChar(255)
  name                String               @db.VarChar(255)
  role                String               @default("user") @db.VarChar(20)
  google_id           String?              @unique @db.VarChar(255)
  avatar              String?              @db.VarChar(500)
  reset_token         String?              @db.VarChar(255)
  reset_token_expires DateTime?            @db.Timestamptz(6)
  is_active           Boolean              @default(true)
  last_login_at       DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @default(now()) @db.Timestamptz(6)
  status              String?              @default("active") @db.VarChar(20)
  chat_threads        chat_threads[]
  orders              orders[]
  payment_audit_logs  payment_audit_logs[]

  @@index([created_at], map: "idx_users_created_at")
  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
}

model webhook_events {
  id              Int       @id @default(autoincrement())
  event_id        String    @unique @db.VarChar(255)
  event_type      String?   @db.VarChar(100)
  payload         Json?
  processed_at    DateTime? @db.Timestamptz(6)
  status          String?   @default("processing") @db.VarChar(20)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  // --- Retry & dead-letter fields (CRITICAL: without these, failed webhooks silently die) ---
  retry_count     Int       @default(0)
  next_retry_at   DateTime? @db.Timestamptz(6)
  error_message   String?
  dead_lettered_at DateTime? @db.Timestamptz(6)

  @@index([status, next_retry_at], map: "idx_webhook_events_retry")
  @@index([dead_lettered_at], map: "idx_webhook_events_dead_letter")
}

/// Outbox pattern: events written atomically with their parent DB change.
/// A background worker reads this table and dispatches downstream side-effects
/// (email, inventory sync, analytics). This guarantees at-least-once delivery
/// even when external services (mail, Postgres replica) are temporarily unavailable.
/// See: docs/architecture/adr/013-outbox-pattern-for-payment-events.md
model outbox_events {
  id             Int       @id @default(autoincrement())
  aggregate_id   String    @db.VarChar(255)   // e.g. orderNumber
  aggregate_type String    @db.VarChar(100)   // e.g. "Order"
  event_type     String    @db.VarChar(100)   // e.g. "order.paid", "order.failed"
  payload        Json                         // full denormalized event payload
  status         String    @default("pending") @db.VarChar(20) // pending | processing | processed | dead_lettered
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  processed_at   DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  max_attempts   Int       @default(5)
  next_attempt_at DateTime? @db.Timestamptz(6)
  last_error     String?
  dead_lettered_at DateTime? @db.Timestamptz(6)

  // Partial index: only index rows that need work — keeps the index tiny as events accumulate
  @@index([status, next_attempt_at], map: "idx_outbox_pending")
  @@index([aggregate_id], map: "idx_outbox_aggregate_id")
  @@index([dead_lettered_at], map: "idx_outbox_dead_letter")
}
